# ==============================================================================
# AlgoLens — .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.env
.env.*
!.env.example

# Streamlit Cache & User Configs
.streamlit/secrets.toml
.streamlit/user/

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# macOS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows System Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Unit Test, Coverage and Pytest Cache
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Logs and Temporary Runtime Output
*.log
algolens/logs/*.log
temp/
tmp/
scratch/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints
